# AVENQUIS Backend - Local Core Live Test
NODE_ENV=development
PORT=8101

# Use separate development and test databases.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/avenquis_dev
TEST_DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/avenquis_test

CORS_ORIGIN_FRONTEND=http://localhost:3101
CORS_ORIGIN_CONTROL_PANEL=http://localhost:4101

# Generate a unique local value. setup-local.bat does this automatically.
JWT_SECRET=REPLACE_WITH_RANDOM_LOCAL_SECRET_AT_LEAST_32_CHARS

# Shared only between the Core and Control backends. Use the same random value
# as CORE_SERVICE_TOKEN in the Control backend; never expose it to either browser.
CONTROL_SERVICE_TOKEN=REPLACE_WITH_RANDOM_CONTROL_SERVICE_TOKEN_AT_LEAST_32_CHARS

# X1 provisioning defaults. Credits are allocated atomically; consumption is implemented in X3.
INDIVIDUAL_INITIAL_CREDITS=1000
FIRM_INITIAL_CREDITS=5000
ACTIVATION_TOKEN_TTL_HOURS=24

# Credential delivery. `memory` is development/test-only. Production must use
# a fully configured `http` or `smtp` provider. Never commit SMTP_PASS.
EMAIL_PROVIDER=memory
EMAIL_API_URL=https://email-provider.example/v1/send
EMAIL_API_KEY=REPLACE_WITH_BACKEND_ONLY_EMAIL_PROVIDER_KEY
EMAIL_FROM=no-reply@avenquis.example
EMAIL_TIMEOUT_MS=10000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=manager.fames@gmail.com
SMTP_PASS=REPLACE_WITH_GMAIL_APP_PASSWORD
CORE_FRONTEND_URL=http://localhost:3101
SUPPORT_EMAIL=support@avenquis.example

# Used by npm run test:integration.
INTEGRATION_BASE_URL=http://localhost:8101/api/v1

PET_PROVIDER=mock
PET_RATE_LIMIT=60

# X7 Core-owned local brain and Groq fallback. PET remains disabled.
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=8000
CHATBOT_LOCAL_CREDITS=1
CHATBOT_AI_STANDARD_CREDITS=10
CHATBOT_AI_HEAVY_CREDITS=25
CHATBOT_LOCAL_SIMILARITY_THRESHOLD=0.72
